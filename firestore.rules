rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Test Connection Rule ---
    match /test/{docId} {
      allow read: if true;
    }

    // --- Users Profiles ---
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Confessions Rules ---
    match /confessions/{confessionId} {
      function isValidConfession(data) {
        return data.text is string && data.text.size() <= 500
            && data.author is string && data.author.size() <= 50
            && data.likes is int
            && data.createdAt is timestamp
            && (!('isArchived' in data) || data.isArchived is bool);
      }

      allow read: if true;
      
      allow create: if isValidId(confessionId) 
                   && isValidConfession(incoming())
                   && incoming().likes == 0
                   && incoming().createdAt == request.time;
      
      allow update: if isValidConfession(incoming())
                   && (
                     // Action: Like
                     (incoming().diff(existing()).affectedKeys().hasOnly(['likes']) && incoming().likes == existing().likes + 1) ||
                     // Action: Archive (Internal use simulation)
                     (incoming().diff(existing()).affectedKeys().hasOnly(['isArchived']))
                   );
    }

    // --- Stats Rules ---
    match /stats/{statId} {
      allow read: if true;
      allow write: if true; // In a real production app, this would be updated via Cloud Functions or restricted, 
                           // but for this demo/remix, we allow client-side updates for simplicity.
    }

    // --- User Specific Responses ---
    match /user_responses/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
